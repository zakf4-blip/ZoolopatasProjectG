<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg"
    android:fillViewport="true"
    tools:context=".iniciosesion">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- ══════════════════════════════════════ -->
        <!-- LOGO con fondo blanco redondeado        -->
        <!-- ══════════════════════════════════════ -->

        <ImageButton
            android:id="@+id/btnVolverAtras"
            android:layout_width="58dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <FrameLayout
            android:id="@+id/frameLogoCircular"
            android:layout_width="154dp"
            android:layout_height="140dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/logo_redondo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/frameLogoLoginI"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_badge_gris">

                <ImageView
                    android:id="@+id/imgLogoLoginI"
                    android:layout_width="71dp"
                    android:layout_height="61dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo Zoolopatas"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_logo" />
            </FrameLayout>
        </FrameLayout>


        <TextView
            android:id="@+id/tvNombreVetConf2"
            android:layout_width="283dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_cielo"
            android:text=" Zoolopatas •  Portal Clínico"
            android:textColor="#007A6E"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frameLogoCircular" />

        <TextView
            android:id="@+id/tvBienvenido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:text="Bienvenido de vuelta"
            android:textColor="#2B2B2B"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNombreVetConf2" />

        <TextView
            android:id="@+id/tvSubLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Accede al historial de salud y citas de tu compañero"
            android:textColor="#777777"
            android:textSize="14sp"
            android:gravity="center"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvBienvenido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ══════════════════════════════════════ -->
        <!-- TARJETA DE ERROR (oculta por defecto)   -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/cardError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_error"
            android:orientation="horizontal"
            android:gravity="top"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Icono error -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛔"
                android:textSize="18sp"
                android:layout_marginEnd="10dp" />

            <!-- Textos de error -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Error de autenticación"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credenciales no válidas. Por favor revisa tu correo y contraseña."
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Botón cerrar error -->
            <Button
                android:id="@+id/btnCerrarError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#C62828"
                app:backgroundTint="#F08B8B"
                android:textSize="16sp"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelCorreoLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textColor="#2B2B2B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardError"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Campo correo con icono ✉ -->
        <LinearLayout
            android:id="@+id/containerCorreo"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_edit_card_gris"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/labelCorreoLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉️"
                android:textSize="16sp"
                android:textColor="#AAAAAA"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etCorreoLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="usuario@ejemplo.com"
                android:textColorHint="#AAAAAA"
                android:textColor="#2B2B2B"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:singleLine="true" />
        </LinearLayout>

        <!-- ══════════════════════════════════════ -->
        <!-- CAMPO: Contraseña con ojo              -->
        <!-- ══════════════════════════════════════ -->
        <TextView
            android:id="@+id/labelPasswordLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textColor="#2B2B2B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/containerCorreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Campo contraseña con 🔒 y 👁 -->
        <LinearLayout
            android:id="@+id/containerPassword"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_edit_card_gris"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/labelPasswordLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="15sp"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etPasswordLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="••••••••"
                android:textColorHint="#AAAAAA"
                android:textColor="#2B2B2B"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:singleLine="true" />

            <!-- Ojo para mostrar/ocultar contraseña -->
        </LinearLayout>

        <!-- ══════════════════════════════════════ -->
        <!-- FILA: Recordar sesión + Olvidé contraseña -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/rowRecordar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/containerPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- CheckBox recordar sesión -->
            <CheckBox
                android:id="@+id/chkRecordar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Recordar sesión?"
                android:textColor="#555555"
                android:textSize="13sp"
                android:buttonTint="#007A6E"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOlvidePassword"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#007A6E"
                android:textSize="13sp"
                android:textStyle="bold"
                app:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRegistrar3"
            android:layout_width="373dp"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:text="Ingresar→"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#007A6E"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rowRecordar" />

        <LinearLayout
            android:id="@+id/rowRegistrar"
            android:layout_width="277dp"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRegistrar3">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Aún no tienes cuenta?  "
                android:textColor="#777777"
                android:textSize="13sp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarseGratis"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="124dp"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:text="Regístrate gratis ›"
                android:textColor="#007A6E"
                android:textSize="13sp"
                android:textStyle="bold"
                app:textAllCaps="false" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
