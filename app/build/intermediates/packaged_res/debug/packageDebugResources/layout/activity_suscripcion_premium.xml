<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sub_screen_bg"
    tools:context=".SuscripcionPremium">

    <!-- ── BARRA SUPERIOR BLANCA CON LOGO Y AVATAR ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivLogoHeader"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="fitCenter"
            android:src="@drawable/img_logo"
            android:contentDescription="Logo Zoolopatas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnProfileAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_profile_circle"
            android:contentDescription="Perfil"
            android:clipToOutline="true"
            android:padding="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── CONTENIDO SCROLLABLE ── -->
    <ScrollView
        android:id="@+id/scrollViewSuscripcion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- ── BARRA DE TÍTULO CON BOTÓN VOLVER ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_back_circle"
                    android:contentDescription="Volver"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvTituloPantalla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="40dp"
                    android:gravity="center"
                    android:text="Selecciona una suscripción"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/btnVolver"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── SECCIÓN HERO: LOGO, BADGE Y NOMBRE DEL PLAN ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Logo central en tarjeta blanca redondeada -->
                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_logo_card"
                    android:elevation="4dp"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_logo"
                        android:contentDescription="Logo Zoolopatas" />
                </FrameLayout>

                <!-- Badge Plan Exclusivo -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_exclusive"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_star_exclusive"
                        android:contentDescription="Plan exclusivo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:letterSpacing="0.04"
                        android:text="PLAN EXCLUSIVO"
                        android:textColor="@color/sub_exclusive_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Título Plan -->
                <TextView
                    android:id="@+id/tvTituloPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Zoolopatas Premium"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <!-- Subtítulo -->
                <TextView
                    android:id="@+id/tvSubtituloPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxWidth="280dp"
                    android:text="La mejor salud y cuidado preventivo para tus mascotas"
                    android:textColor="@color/sub_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- ── TARJETA PRINCIPAL DE SUSCRIPCIÓN Y PRECIOS ── -->
            <LinearLayout
                android:id="@+id/cardSuscripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_subscription_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <!-- Precio principal (S/ 16.99 / mes) -->
                <LinearLayout
                    android:id="@+id/layoutPrecioPrincipalContenedor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPrecioPrincipal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S/ 16.99"
                        android:textColor="@color/sub_price_teal"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPeriodoPrecio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="/ mes"
                        android:textColor="@color/sub_price_month"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Precio secundario anual -->
                <TextView
                    android:id="@+id/tvPrecioSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="o S/ 134.99 al año"
                    android:textColor="@color/sub_text_secondary"
                    android:textSize="12sp" />

                <!-- Badge de Ahorro anual -->
                <TextView
                    android:id="@+id/tvBadgeAhorro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_savings"
                    android:paddingStart="16dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="5dp"
                    android:text="Ahorras S/ 68.89 al año"
                    android:textColor="@color/sub_amber_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- BOTONES DE TOGGLE SEGMENTADO (Mensual vs Anual) -->
                <LinearLayout
                    android:id="@+id/layoutTogglePlanes"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_toggle_container"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <!-- Botón Selección Plan Mensual -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlanMensual"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Mensual"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/teal_primary"
                        app:cornerRadius="10dp"
                        app:elevation="0dp" />

                    <!-- Botón Selección Plan Anual con Badge de Descuento -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlanAnual"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Anual  -34%"
                        android:textAllCaps="false"
                        android:textColor="@color/sub_text_secondary"
                        android:textSize="13sp"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="10dp"
                        app:elevation="0dp" />
                </LinearLayout>

                <!-- BOTÓN PRINCIPAL CTA: Suscribirme ahora -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSuscribirmeAhora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="18dp"
                    android:text="Suscribirme ahora"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/teal_primary"
                    app:cornerRadius="12dp"
                    app:elevation="2dp"
                    app:icon="@drawable/ic_arrow_forward_white"
                    app:iconGravity="textEnd"
                    app:iconPadding="10dp"
                    app:iconSize="18dp" />

                <!-- BOTÓN SECUNDARIO: Prefiero anualmente -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrefieroAnual"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Prefiero anualmente"
                    android:textAllCaps="false"
                    android:textColor="#00BFA5"
                    android:textSize="13sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <!-- ── SECCIÓN: ¿Qué incluye Zoolopatas Premium? ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">

                <TextView
                    android:id="@+id/tvTituloBeneficios"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="¿Qué incluye Zoolopatas Premium?"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivVerifiedBadge"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/ivVerifiedBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_verified_teal"
                    android:contentDescription="Verificado"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BENEFICIO 1: Hasta 20 mascotas registradas -->
            <LinearLayout
                android:id="@+id/cardBeneficioMascotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_feature_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_feature_icon_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_paw"
                        app:tint="@color/sub_price_teal"
                        android:contentDescription="Mascotas registradas" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hasta 20 mascotas registradas"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:text="En lugar de 3 del plan gratuito para cuidar a toda tu manada."
                        android:textColor="@color/sub_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BENEFICIO 2: Historial clínico ilimitado -->
            <LinearLayout
                android:id="@+id/cardBeneficioHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_feature_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_feature_icon_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_medical_record"
                        app:tint="@color/sub_price_teal"
                        android:contentDescription="Historial clínico" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Historial clínico ilimitado"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Sin restricciones de vacunas, consultas o desparasitaciones."
                        android:textColor="@color/sub_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BENEFICIO 3: Recordatorios ilimitados -->
            <LinearLayout
                android:id="@+id/cardBeneficioRecordatorios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_feature_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_feature_icon_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/sub_price_teal"
                        android:contentDescription="Recordatorios" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recordatorios ilimitados"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Programa todas las alertas médicas y antiparasitarias sin tope."
                        android:textColor="@color/sub_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── FOOTER: PAGO SEGURO Y ENCRIPTADO ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_lock_teal"
                    android:contentDescription="Seguro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Pago 100% seguro y encriptado. Cancela cuando quieras."
                    android:textColor="@color/sub_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── BARRA DE NAVEGACIÓN INFERIOR (BOTONES DE NAVEGACIÓN) ── -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón Inicio -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavInicio"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Inicio"
            android:textAllCaps="false"
            android:textColor="@color/dashboard_nav_unselected"
            android:textSize="11sp"
            app:icon="@drawable/ic_home"
            app:iconGravity="textTop"
            app:iconPadding="3dp"
            app:iconSize="24dp"
            app:iconTint="@color/dashboard_nav_unselected" />

        <!-- Botón Notificaciones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavNotificaciones"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Notificaciones"
            android:textAllCaps="false"
            android:textColor="@color/dashboard_nav_unselected"
            android:textSize="11sp"
            app:icon="@drawable/ic_nav_bell"
            app:iconGravity="textTop"
            app:iconPadding="3dp"
            app:iconSize="24dp"
            app:iconTint="@color/dashboard_nav_unselected" />

        <!-- Botón Perfil -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavPerfil"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Perfil"
            android:textAllCaps="false"
            android:textColor="@color/dashboard_teal_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_nav_person"
            app:iconGravity="textTop"
            app:iconPadding="3dp"
            app:iconSize="24dp"
            app:iconTint="@color/dashboard_teal_text" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
