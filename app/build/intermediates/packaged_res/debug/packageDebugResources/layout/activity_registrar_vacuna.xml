<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg"
    tools:context=".registrar_vacuna">

    <!-- ══════════════════════════════════════════════════ -->
    <!-- TOOLBAR SUPERIOR                                   -->
    <!-- ══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/toolbarVacunacion"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón Atrás -->
        <ImageButton
            android:id="@+id/btnBackVacunacion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:tint="#2B2B2B" />

        <!-- Icono jeringa / Vacuna -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_vaccines"
            app:tint="@color/dashboard_teal_text"
            android:contentDescription="Icono vacuna" />

        <!-- Título -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Nueva Vacunación"
            android:textColor="#1F2428"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Avatar perfil -->
        <ImageButton
            android:id="@+id/btnProfileAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_profile_circle"
            android:contentDescription="Perfil"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_person"
            app:layout_constraintEnd_toEndOf="parent" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- CONTENIDO SCROLLABLE                               -->
    <!-- ══════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/scrollViewVacunacion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbarVacunacion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- ══════════════════════════════════════════════════ -->
            <!-- TARJETA INFORMACIÓN DE LA MASCOTA                  -->
            <!-- ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/cardInfoMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <!-- Foto de Rocky -->
                <ImageView
                    android:id="@+id/imgFotoMascota"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_dog_icon_completo"
                    android:contentDescription="Foto de Rocky"
                    android:background="@drawable/bg_avatar_circle" />

                <!-- Datos de la mascota -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreMascota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rocky"
                        android:textColor="#1F2428"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Punto indicador teal -->
                        <ImageView
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:src="@drawable/ic_dot_teal"
                            android:contentDescription="Indicador" />

                        <TextView
                            android:id="@+id/tvInfoMascota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Golden Retriever • 3 años • 28.4 kg"
                            android:textColor="#5E5E5E"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- TIPO DE REGISTRO (Spinner)                         -->
            <!-- ══════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="TIPO DE REGISTRO"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinnerTipoRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:spinnerMode="dropdown"
                    android:entries="@array/tipo_registro_vacuna_array"
                    android:backgroundTint="#6B7280" />
            </LinearLayout>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- TARJETA FORMULARIO DE VACUNACIÓN                   -->
            <!-- ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/cardFormulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ── Fecha de aplicación ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fecha de aplicación"
                        android:textColor="#1F2428"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Asterisco obligatorio -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="#DC2626"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="DD/MM/AAAA"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Campo de fecha de aplicación -->
                <LinearLayout
                    android:id="@+id/layoutFechaAplicacion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/tvFechaAplicacion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="15 / 10 / 2024"
                        android:textColor="#1F2428"
                        android:textSize="15sp" />

                    <!-- Icono calendario -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#6B7280"
                        android:contentDescription="Seleccionar fecha" />

                    <!-- Icono editar -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_edit"
                        app:tint="#6B7280"
                        android:contentDescription="Editar fecha" />
                </LinearLayout>

                <!-- Mensaje de validación fecha -->
                <LinearLayout
                    android:id="@+id/layoutValidacionFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="#059669"
                        android:contentDescription="Validado" />

                    <TextView
                        android:id="@+id/tvValidacionFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Fecha validada correctamente"
                        android:textColor="#059669"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ── Separador sutil ── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#F3F4F6" />

                <!-- ── Motivo o tipo de Vacuna ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Motivo o tipo de vacuna"
                        android:textColor="#1F2428"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="#DC2626"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Campo tipo de Vacuna -->
                <LinearLayout
                    android:id="@+id/layoutTipoVacuna"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/tvTipoVacuna"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vacuna Antirrábica Anual"
                        android:textColor="#1F2428"
                        android:textSize="15sp" />

                    <!-- Icono escudo / Vacuna verificada -->
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="#007A6E"
                        android:contentDescription="Vacuna verificada" />
                </LinearLayout>

                <!-- Mensaje informativo tipo Vacuna -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_info"
                        app:tint="#6B7280"
                        android:contentDescription="Información" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Esquema preventivo prioritario de control zoonótico"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ── Separador sutil ── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#F3F4F6" />

                <!-- ── Fecha de vencimiento o próximo refuerzo ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha de vencimiento o próximo refuerzo"
                        android:textColor="#1F2428"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="#DC2626"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Campo fecha de vencimiento -->
                <LinearLayout
                    android:id="@+id/layoutFechaVencimiento"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/tvFechaVencimiento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="15 / 10 / 2025"
                        android:textColor="#1F2428"
                        android:textSize="15sp" />

                    <!-- Icono calendario -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#6B7280"
                        android:contentDescription="Seleccionar fecha vencimiento" />

                    <!-- Icono alarma / recordatorio -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_alerta"
                        app:tint="#B7791F"
                        android:contentDescription="Recordatorio de refuerzo" />
                </LinearLayout>

                <!-- Mensaje de validación vencimiento -->
                <LinearLayout
                    android:id="@+id/layoutValidacionVencimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="#059669"
                        android:contentDescription="Validado" />

                    <TextView
                        android:id="@+id/tvValidacionVencimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Fecha posterior y válida (intervalo seguro)"
                        android:textColor="#059669"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ── Separador sutil ── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#F3F4F6" />

                <!-- ── Comentarios adicionales y observaciones ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comentarios adicionales y observaciones"
                    android:textColor="#1F2428"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etComentarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top|start"
                    android:hint="Escribe observaciones sobre la vacunación..."
                    android:inputType="textMultiLine"
                    android:maxLength="300"
                    android:minHeight="90dp"
                    android:padding="14dp"
                    android:text="Aplicado sin reacción alérgica local ni fiebre."
                    android:textColor="#374151"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3" />

                <!-- Contador de caracteres -->
                <TextView
                    android:id="@+id/tvContadorCaracteres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="44 / 300"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- BOTÓN GUARDAR VACUNACIÓN                           -->
            <!-- ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/btnGuardarVacunacion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_guardar_vacuna"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Icono check / guardar -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#FFFFFF"
                    android:contentDescription="Guardar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Guardar Vacunación"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>