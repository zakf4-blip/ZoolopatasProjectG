<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg"
    tools:context=".catalogo_recetas">

    <!-- ══════════════════════════════════════════════════ -->
    <!-- BARRA SUPERIOR: Atrás + Logo centrado + Avatar    -->
    <!-- ══════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBackRecetas"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:tint="#2B2B2B"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_paw"
                android:contentDescription="Logo Zoolopatas" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Zoolopatas"
                android:textColor="@color/dashboard_teal_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnProfileAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_profile_circle"
            android:contentDescription="Perfil"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_person"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- CONTENIDO SCROLLABLE                               -->
    <!-- ══════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/scrollViewRecetas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <!-- ── Título de la sección ── -->
            <TextView
                android:id="@+id/tvTituloCatalogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Catálogo de Recetas y Snacks"
                android:textColor="#1F2428"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Recetas caseras verificadas por veterinarios nutricionistas."
                android:textColor="#5E5E5E"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.15" />

            <!-- ── Filtro Spinner: Perro / Gato ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_spinner_border"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinnerTipoMascota"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:spinnerMode="dropdown"
                        android:entries="@array/tipo_mascota_array"
                        android:backgroundTint="#007A6E" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- LISTADO VERTICAL DE TARJETAS DE RECETAS           -->
            <!-- ══════════════════════════════════════════════════ -->

            <!-- ── Tarjeta Receta 1: Bocaditos de Pollo y Zanahoria ── -->
            <LinearLayout
                android:id="@+id/cardReceta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Imagen referencial de la mascota -->
                <ImageView
                    android:id="@+id/imgMascota1"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_eat_dog"
                    android:contentDescription="Imagen de perro"
                    android:background="@drawable/bg_image_rounded" />

                <!-- Imagen referencial del platillo -->

                <!-- Info de la receta -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReceta1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bocaditos de Pollo y Zanahoria"
                        android:textColor="#1F2428"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvTipoReceta1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Receta para perros"
                        android:textColor="#007A6E"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#007A6E"
                        android:contentDescription="Ver receta" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Tarjeta Receta 2: Mini Snack de Verduras ── -->
            <LinearLayout
                android:id="@+id/cardReceta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/imgMascota2"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_eat_dog"
                    android:contentDescription="Imagen de perro"
                    android:background="@drawable/bg_image_rounded" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReceta2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mini Snack de Verduras Seguras"
                        android:textColor="#1F2428"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvTipoReceta2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Receta para perros"
                        android:textColor="#007A6E"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#007A6E"
                        android:contentDescription="Ver receta" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Tarjeta Receta 3: Galletas de Avena y Plátano ── -->
            <LinearLayout
                android:id="@+id/cardReceta3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/imgMascota3"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_eat_dog"
                    android:contentDescription="Imagen de perro"
                    android:background="@drawable/bg_image_rounded" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReceta3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Galletas de Avena y Plátano"
                        android:textColor="#1F2428"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvTipoReceta3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Receta para perros"
                        android:textColor="#007A6E"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#007A6E"
                        android:contentDescription="Ver receta" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Tarjeta Receta 4: Bocadito de Verduras para Gato ── -->
            <LinearLayout
                android:id="@+id/cardReceta4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/imgMascota4"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_eat_dog"
                    android:contentDescription="Imagen de gato"
                    android:background="@drawable/bg_image_rounded" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReceta4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bocadito de Pollo para Gato"
                        android:textColor="#1F2428"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvTipoReceta4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Receta para gatos"
                        android:textColor="#B7791F"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#B7791F"
                        android:contentDescription="Ver receta" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Tarjeta Receta 5: Snack de Atún para Gato ── -->
            <LinearLayout
                android:id="@+id/cardReceta5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/imgMascota5"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_eat_dog"
                    android:contentDescription="Imagen de gato"
                    android:background="@drawable/bg_image_rounded" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReceta5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Snack de Atún y Calabaza"
                        android:textColor="#1F2428"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvTipoReceta5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Receta para gatos"
                        android:textColor="#B7791F"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#B7791F"
                        android:contentDescription="Ver receta" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- BARRA DE NAVEGACIÓN INFERIOR                       -->
    <!-- ══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavInicio"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Inicio"
            android:textColor="@color/dashboard_teal_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_home"
            app:iconGravity="textTop"
            app:iconTint="@color/dashboard_teal_text"
            app:iconSize="24dp"
            app:iconPadding="3dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavNotificaciones"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Notificaciones"
            android:textColor="@color/dashboard_nav_unselected"
            android:textSize="11sp"
            app:icon="@drawable/ic_nav_bell"
            app:iconGravity="textTop"
            app:iconTint="@color/dashboard_nav_unselected"
            app:iconSize="24dp"
            app:iconPadding="3dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavPerfil"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Perfil"
            android:textColor="@color/dashboard_nav_unselected"
            android:textSize="11sp"
            app:icon="@drawable/ic_nav_person"
            app:iconGravity="textTop"
            app:iconTint="@color/dashboard_nav_unselected"
            app:iconSize="24dp"
            app:iconPadding="3dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
