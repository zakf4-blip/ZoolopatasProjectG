        <activity
            android:name=".PerfilUsuario"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EditarPerfil"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CuidadosBienestar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".InformacionMascota"
