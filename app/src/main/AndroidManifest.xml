        <activity
            android:name=".confirmacion_registro"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".iniciosesion"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
