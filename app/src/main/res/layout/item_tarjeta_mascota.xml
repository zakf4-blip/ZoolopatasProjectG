<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMascotaContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Avatar circular de la Mascota -->
        <androidx.cardview.widget.CardView
            android:layout_width="66dp"
            android:layout_height="66dp"
            app:cardCornerRadius="33dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false">

            <ImageView
                android:id="@+id/ivAvatarMascota"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_dog_icon_completo"
                android:contentDescription="Avatar Mascota" />
        </androidx.cardview.widget.CardView>

        <!-- Datos de la mascota -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fila con Nombre + Tag Especie -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNombreMascota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="#1F2428"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEspecieMascota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tag_pet"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Canino"
                    android:textColor="@color/dashboard_teal_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Raza -->
            <TextView
                android:id="@+id/tvRazaMascota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Raza"
                android:textColor="#374151"
                android:textSize="14sp" />

            <!-- Edad, Sexo y Castración -->
            <TextView
                android:id="@+id/tvDetalleMascota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Edad • Sexo"
                android:textColor="@color/gray_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Espacio reservado para el botón de opciones -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />
    </LinearLayout>

    <!-- Botón interactivo de la tarjeta completa (abre detalle) -->
    <Button
        android:id="@+id/btnTarjetaMascota"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        app:backgroundTint="@null"
        android:contentDescription="Ver detalle de mascota" />

    <!-- Botón de opciones (tres puntos: Editar / Eliminar) -->
    <ImageButton
        android:id="@+id/btnOpciones"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="Opciones de mascota" />
</FrameLayout>
